GOOGLE_API_KEY=
GROQ_API_KEY=
# Optional third fallback link (skipped when unset)
OPENROUTER_API_KEY=

# Optional LangSmith tracing of the Editor deep agent + subagents only (off when the key is unset).
# Leave LANGSMITH_TRACING unset: tracing is enabled per call in src/agents/deep_agent.py.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=virallens-deep-agent
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # EU region only

# Optional overrides (defaults live in src/llm.py)
# GROQ_MODEL_LARGE=openai/gpt-oss-120b
# GROQ_MODEL_SMALL=openai/gpt-oss-20b
# GROQ_MODEL_ALT=qwen/qwen3.8-27b
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# LLM_CACHE_PATH=.langchain.db
